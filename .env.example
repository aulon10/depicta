# Copy this file to .env and fill in real values. NEVER commit .env.
# The API refuses to start in Production without a real signing key.

# Database password (used by both the db and the api services).
POSTGRES_PASSWORD=change-me-strong-db-password

# JWT signing key — at least 32 bytes of entropy. Generate one, e.g.:
#   openssl rand -base64 48
AUTH_SIGNING_KEY=

# Admin login.
ADMIN_USERNAME=admin
# PBKDF2 hash for the admin password. Generate it with the built-in helper:
#   dotnet run --project backend/Depicta.Api -- hash "your-strong-password"
ADMIN_PASSWORD_HASH=

# Anthropic API key for the Vision provider.
VISION_API_KEY=

# Public origin of the web app (for CORS) and the API base the web app calls.
# For local compose the defaults are fine; set real https URLs when you deploy.
FRONTEND_ORIGIN=http://localhost:8081
VITE_API_BASE=http://localhost:8080
