<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.32" />
    <!-- Error tracking (no-op when no DSN is configured, e.g. local dev). -->
    <PackageReference Include="Sentry.AspNetCore" Version="6.12.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.21" />
    <!-- SQLite for zero-setup local dev; PostgreSQL for production. Provider is chosen in config. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.21" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.21">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.0" />
    <!-- Converts non-web image formats (AVIF, HEIC, TIFF, …) to JPEG for the Vision API. -->
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="15.0.0" />
  </ItemGroup>

</Project>
